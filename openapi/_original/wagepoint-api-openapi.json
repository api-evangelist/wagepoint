    "/v1/companies/{company_id}/persons": {
      "get": {
        "tags": [
          "Persons"
        ],
        "operationId": "ListPersons",
        "parameters": [
          {
            "name": "company_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "description": "Page size, 1..100. Defaults to 100. Free per request; it should remain constant across a page sequence because ordering is unstable and a sequence is not a consistent snapshot.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Opaque, forward-only pagination cursor. Do not decode or construct it; resend it verbatim. A page sequence is not a consistent snapshot; changing page_size mid-sequence can skip or duplicate persons.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of persons",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paged_response_person_response"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem_details"
                }
              }
            }
          },
          "422": {
            "description": "A value could not be converted to the expected type",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem_details"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem_details"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem_details"
                }
              }
            }
          },
          "502": {
            "description": "Upstream bad response or contract violation",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem_details"
                }
              }
            }
          },
          "503": {
            "description": "Upstream unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem_details"
                }
              }
            }
          },
          "504": {
            "description": "Upstream timeout",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/problem_details"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token"
          }
        },
        "security": [
          {
            "bearerAuth": [ ]
          }
        ]
      }
    },
