            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "Case-insensitive name prefix filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by a single company status value (snake_case, e.g. active).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Repeated company id filter, e.g. ?id=1&id=2.",
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "Opaque, forward-only pagination cursor. Do not decode or construct it; resend it verbatim.",
            "schema": {
              "type": "string"
            }
          }
